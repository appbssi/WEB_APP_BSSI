rules_version = '2';

// Règles d'accès sBSSI
//
// Le rôle n'est plus choisi par le navigateur : il est inscrit dans le jeton
// Firebase par le serveur (route /api/auth/idc) après vérification de l'IDC.
//   request.auth.token.role      : 'admin' | 'secretariat' | 'observer'
//   request.auth.token.idc       : IDC saisi à la connexion
//   request.auth.token.agentId   : document agent correspondant (ou null)
//
// Une session anonyme ou sans rôle signé n'a accès à RIEN.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'secretariat', 'observer'];
    }
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }
    function isSecretariat() {
      return signedIn() && request.auth.token.role == 'secretariat';
    }
    function myIdc() {
      return request.auth.token.idc;
    }
    function myAgentId() {
      return request.auth.token.get('agentId', null);
    }
    // Seuls ces champs sont modifiés par la requête
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // --- Administrateurs : accès complet à toutes les rubriques -------------
    // Les collections dont le nom commence par « _ » (mots de passe des agents, limitation
    // des connexions) sont réservées au serveur : aucun navigateur n'y accède, même admin.
    match /{collectionId}/{document=**} {
      allow read, write: if isAdmin() && !collectionId.matches('_.*');
    }

    // --- Données de référence lisibles par tout utilisateur connecté -------
    match /agents/{id} {
      allow read: if signedIn();
      // L'agent peut changer SA photo de profil, et rien d'autre sur sa fiche (~150 Ko max)
      allow update: if signedIn()
        && myAgentId() == id
        && onlyChanges(['photo'])
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 200000;
    }
    match /missions/{id}    { allow read: if signedIn(); }
    match /weapons/{id}     { allow read: if signedIn(); }
    match /settings/{id}    { allow read: if signedIn(); }

    // --- Matériel attribué : chaque agent ne voit que le sien ---------------
    match /weaponAssignments/{id} {
      allow read: if signedIn() && resource.data.agentId == myAgentId();
    }

    // --- Demandes d'absence : chaque agent ne gère que les siennes ----------
    match /demandes/{id} {
      allow read: if signedIn() && resource.data.agentId == myIdc();
      allow create: if signedIn()
        && request.resource.data.agentId == myIdc()
        && request.resource.data.status == 'en_attente';
      // L'agent peut seulement marquer ses demandes comme vues
      allow update: if signedIn()
        && resource.data.agentId == myIdc()
        && onlyChanges(['notified', 'vu_par_agent']);
      allow delete: if signedIn() && resource.data.agentId == myIdc();

      // Pièce jointe (justificatif) : écrite avec la demande, lue par son auteur
      match /files/{fileId} {
        allow read, delete: if signedIn()
          && get(/databases/$(database)/documents/demandes/$(id)).data.agentId == myIdc();
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/demandes/$(id)).data.agentId == myIdc()
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() < 1000000;
      }
    }

    // --- Demandes d'explication / sanctions --------------------------------
    // L'agent lit les siennes et y répond, mais ne peut ni les créer ni les effacer.
    match /explications/{id} {
      allow read: if signedIn() && resource.data.agentId == myAgentId();
      allow update: if signedIn()
        && resource.data.agentId == myAgentId()
        && onlyChanges(['replyText', 'replyDate', 'status', 'notifiedAdmin', 'notifiedAgent', 'notifiedAgentSanction'])
        && request.resource.data.status in [resource.data.status, 'repondu'];
    }

    // --- Documents PDF : chaque agent lit ceux qui le concernent ------------
    // Les ordres de mission NON signés ont agentIds vide : aucun agent ne les reçoit.
    match /pdf_documents/{id} {
      allow read: if signedIn() && resource.data.agentIds.hasAny([myAgentId(), myIdc()]);
    }

    // --- Ordres de mission signés (scan archivé) ----------------------------
    // agentIds n'est rempli qu'à l'archivage du scan signé, avec les seuls agents de la mission.
    match /signed_orders/{id} {
      allow read: if signedIn() && resource.data.agentIds.hasAny([myAgentId(), myIdc()]);

      match /files/{fileId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/signed_orders/$(id)).data.status == 'archive'
          && get(/databases/$(database)/documents/signed_orders/$(id)).data.agentIds.hasAny([myAgentId(), myIdc()]);
      }
    }

    // --- Secrétariat : rubriques Secrétariat, Rassemblements, GAV, Saisies --
    match /visitors/{id}      { allow read, write: if isSecretariat(); }
    match /contacts/{id}      { allow read, write: if isSecretariat(); }
    match /broadcasts/{id}    { allow read, write: if isSecretariat(); }
    match /gatherings/{id}    { allow read, write: if isSecretariat(); }
    match /detainees/{id}     { allow read, write: if isSecretariat(); }
    match /saisies/{id}       { allow read, write: if isSecretariat(); }
    match /activity_logs/{id} { allow create: if isSecretariat(); }
    // Journal d'activité : le secrétariat peut y ajouter une ligne, pas le lire ni le modifier
    match /activities/{id}    { allow create: if isSecretariat(); }

    // --- Messagerie interne ------------------------------------------------
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      // Cocher la check-list d'un ordre de mission
      allow update: if signedIn() && onlyChanges(['text']);
    }

    // --- Position des appareils --------------------------------------------
    // Chacun ne peut publier que SA position ; seuls les admins les consultent.
    match /device_locations/{id} {
      allow create, update: if signedIn()
        && request.resource.data.userIdc == myIdc()
        && request.resource.data.role == request.auth.token.role;
    }

    // Toute autre collection (informations, renseignements, finances, armurerie, logistique, journal d'activité,
    // limitation des connexions…) : administrateurs uniquement.
  }
}
