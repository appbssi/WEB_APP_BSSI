# Variables du serveur pour la connexion par IDC.
# Copier ce fichier en .env.local pour le développement (jamais commité),
# et définir les mêmes variables dans Vercel > Project > Settings > Environment Variables.

# Clé du compte de service Firebase (Console Firebase > Paramètres du projet >
# Comptes de service > Générer une nouvelle clé privée).
# Coller le JSON complet sur une seule ligne, ou ce JSON encodé en base64.
FIREBASE_SERVICE_ACCOUNT=

# IDC des administrateurs (accès complet), séparés par des virgules.
ADMIN_IDCS=

# IDC des administrateurs à accès limité (tableau de bord, cartographie, agents,
# missions, logistique, GAV, saisies).
RESTRICTED_ADMIN_IDCS=

# IDC du secrétariat.
SECRETARIAT_IDCS=

# (Optionnel) Adresse qui reçoit une notification à chaque création de mission
# (nom, lieu, dates et noms des agents). Laisser vide pour ne rien envoyer à l'extérieur.
MISSION_WEBHOOK_URL=

# Les agents se connectent avec leur matricule ou leur IDC personnel :
# ils sont reconnus automatiquement à partir de la collection « agents ».
